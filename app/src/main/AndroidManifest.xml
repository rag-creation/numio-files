<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No INTERNET permission: Files never goes online.
         The line below also strips it if a library ever tries to add it. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!-- A file manager has to see every folder. Android 11+ asks for
         "All files access" in its own settings screen; older phones use these two. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Lets "Lock Files" show Android's own fingerprint / PIN prompt. Never asks you anything. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Only so tapping an .apk can hand it to Android's installer.
         Android still asks the person before anything is installed. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Files">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with Files" for ZIPs from WhatsApp, Downloads, email apps… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-zip" />
            </intent-filter>

            <!-- "Open with Files" for Apple Pages, Numbers and Keynote files, and Word / Excel files.
                 Chat apps often send them as plain "octet-stream", so that is accepted too;
                 Files then decides by the file name what it can show. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.apple.pages" />
                <data android:mimeType="application/x-iwork-pages-sffpages" />
                <data android:mimeType="application/vnd.apple.numbers" />
                <data android:mimeType="application/x-iwork-numbers-sffnumbers" />
                <data android:mimeType="application/vnd.apple.keynote" />
                <data android:mimeType="application/x-iwork-keynote-sffkey" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>

            <!-- "Open with Files" for text: TXT, Markdown, CSV, JSON, HTML, XML -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="image/svg+xml" />
            </intent-filter>
        </activity>

        <!-- Lends single files to other apps when opening or sharing them -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
